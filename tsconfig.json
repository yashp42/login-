{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "outDir": ".output",
    "allowJs": true,
    "sourceMap": true,
    "noImplicitAny": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noImplicitReturns": true
  },
  "exclude": ["node_modules", ".output", "coverage"]
}
