{
  "env": {
    "webextensions": true,
    "browser": true,
    "es2021": true
  },
  "extends": ["standard-with-typescript"],
  "overrides": [],
  "parser": "@typescript-eslint/parser",
  "plugins": ["@typescript-eslint", "import"],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": "off",
    "@typescript-eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "ignoreRestSiblings": true
      }
    ],
    "no-console": ["error", { "allow": ["warn", "error"] }]
  }
}
