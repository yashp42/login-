{
  "name": "kgp-erp-one-click-login",
  "version": "0.1.0",
  "description": "Chrome extension for locally stored IIT Kharagpur ERP login autofill.",
  "repository": "https://github.com/yashp42/login.git",
  "license": "MPL-2.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build --browser chrome",
    "typecheck": "wxt prepare && tsc --noEmit",
    "lint": "eslint --max-warnings=0 .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "web-ext:lint": "node scripts/web-ext-lint.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/forms": "^0.5.4",
    "@types/chrome": "^0.0.241",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "autoprefixer": "^10.4.14",
    "eslint": "^8.45.0",
    "eslint-config-standard-with-typescript": "^36.1.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-n": "^16.0.1",
    "eslint-plugin-promise": "^6.1.1",
    "prettier": "^3.0.0",
    "prettier-plugin-tailwindcss": "^0.4.1",
    "tailwindcss": "^3.3.3",
    "typescript": "^5.1.6",
    "vitest": "^5.0.3",
    "web-ext": "^10.7.0",
    "wxt": "^0.21.4"
  }
}
